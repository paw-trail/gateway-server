<?xml version="1.0" encoding="UTF-8"?>
<!--
  로깅 설정임

  파일 이름이 반드시 logback-spring.xml 이어야 함
  logback.xml 로 두면 스프링 확장이 걸리지 않아 <springProfile> 과 <springProperty> 가
  오류 없이 조용히 무시됨

  * <springProfile> 은 최상위에만 둘 수 있음
    <root>·<appender>·<logger> 안에 넣으면 아래 경고가 뜨고 동작이 보장되지 않음
      <springProfile> elements cannot be nested within an <appender>, <logger> or <root> element
    logback 은 <springProfile> 을 먼저 처리하는데 <root> 안쪽은 나중에 처리하므로
    평가 시점이 어긋나기 때문임
    따라서 프로파일마다 <root> 를 따로 두는 것이 지원되는 형태임

  도메인 서비스는 appender 정의를 공통 모듈 jar 에서 include 해 오지만
  이 서비스는 공통 모듈을 의존하지 않으므로 여기에 직접 적음

  * lokiUrl 값이 자기 application.yml 이 아니라 config 저장소에서 내려옴
    logback 초기화보다 설정 수신이 먼저 일어나야 값이 잡히므로
    dev 프로파일로 컨테이너에서 띄울 때 Loki 에 로그가 도착하는지 확인할 것
    도착 여부는 아래로 봄, data 필드가 채워져 있어야 함
      curl.exe http://localhost:3100/loki/api/v1/labels
-->
<configuration>

    <!-- Boot 이 제공하는 기본 변수와 콘솔 appender 정의임 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 설정값을 logback 변수로 끌어옴 -->
    <springProperty name="appName" source="spring.application.name" defaultValue="gateway-server"/>
    <springProperty name="lokiUrl" source="app.logging.loki.url"
                    defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <!--
      local 은 IntelliJ 에서 도는 경우임
      Loki 로 보내지 않으므로 appender 를 아예 만들지 않음
    -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!--
      local 이 아닌 경우는 컨테이너에서 도는 경우임

      라벨은 Loki 가 색인하는 값이라 종류가 적어야 함(저카디널리티)
      쉼표를 쓰지 않고 한 줄에 하나씩 적는 것이 loki4j 2.x 문법이며
      1.x 의 <format><label><pattern>a=1,b=2</pattern></label></format> 구조는 없어졌음
    -->
    <springProfile name="!local">

        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">

            <labels>
                app = ${appName}
                level = %level
            </labels>

            <!--
              structured metadata 는 색인되지 않으므로 값이 많은 것을 담기에 적합함
              traceId 와 spanId 는 MDC 에 있는 것을 loki4j 2.x 가 자동으로 실어 보냄

              이 서비스는 요청이 처음 들어오는 자리이므로 여기에 찍힌 traceId 가
              뒤쪽 서비스들의 로그와 같아야 함
              Grafana 의 Loki 데이터소스가 그 값으로 Zipkin 트레이스로 건너뛰게 되어 있음
            -->
            <structuredMetadata>
                thread = %thread
                logger = %logger
            </structuredMetadata>

            <message>
                <pattern>%msg%n%ex</pattern>
            </message>

            <http>
                <url>${lokiUrl}</url>
            </http>

        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>

    </springProfile>

</configuration>
